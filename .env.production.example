# =============================================================================
# 201Bet — produção na Hostinger VPS (Coolify + docker-compose.yml)
# Copie para Environment da Coolify ou .env.production (NÃO commitar segredos).
# =============================================================================

# --- Domínios (substitua) ---
# Site público + admin no mesmo Next; API e WS no mesmo host via nginx.
SITE_HOST=palpite201.com
ADMIN_HOST=admin.palpite201.com

# --- Postgres (interno ao compose) ---
POSTGRES_DB=betdb
POSTGRES_USER=betuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Auth ---
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET!!
JWT_EXPIRES_IN=8h
# Mesmo domínio raiz (subdomínios): lax. Só use none se front/API forem sites distintos.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=.palpite201.com

# --- CORS / links de e-mail ---
# Inclua site e admin (HTTPS).
CORS_ORIGIN=https://palpite201.com,https://www.palpite201.com,https://admin.palpite201.com
FRONTEND_URL=https://palpite201.com

# --- Frontend (build-time — rebuild obrigatório ao mudar) ---
NEXT_PUBLIC_API_URL=https://palpite201.com/api
NEXT_PUBLIC_WS_URL=https://palpite201.com/realtime
NEXT_PUBLIC_SITE_HOST=palpite201.com
NEXT_PUBLIC_ADMIN_SITE_HOST=admin.palpite201.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://palpite201.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Backend opcional ---
GOOGLE_CLIENT_ID=
EMAIL_PROVIDER=noop
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=201Bet
EMAIL_REPLY_TO=
EMAIL_DAILY_LIMIT=200
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_LOGO_URL=

# --- Cache Upstash (deixe vazio na VPS; Redis local cobre filas) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Backup container (profile backup) ---
BACKUP_RETENTION_DAYS=14

# --- Coolify / publish ---
# Coolify costuma mapear o serviço nginx; 80 é o default interno.
NGINX_PUBLISH_PORT=80
